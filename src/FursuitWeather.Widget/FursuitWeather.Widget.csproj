<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 下限は Windows 11 22H2。Windows 10 の一般サポートは2025年10月14日に終了している -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Windows App SDK は AnyCPU に対応しないため、通知を足すときに要る。

      注意: 出力先が2系統に分かれる。
        dotnet build <slnx>   → bin/x64/Release/...
        dotnet build <csproj> → bin/Release/...
      手で起動して確かめるときは、新しいほうを選ぶこと。
      古いほうを掴んで「直したはずの挙動が出ない」と誤診した実例がある。
    -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 画面の部品には公開ドキュメントを求めない -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      LibraryImport（P/Invoke のソース生成）が要求する。
      Win32 の呼び出しはこのプロジェクトに閉じ込め、Core へは波及させない
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      MSIX でパッケージ化しない。インストーラーが Windows App SDK の
      ランタイムを連鎖インストールする前提で使う
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FursuitWeather.Core\FursuitWeather.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\tray.ico" />
    <!-- 通知のアイコンはファイルの場所を渡す必要があるため、実体も出力へ置く -->
    <None Include="Resources\tray.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
