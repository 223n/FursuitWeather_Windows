<Window x:Class="FursuitWeather.Widget.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="FursuitWeather"
        Width="300" Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        SourceInitialized="OnSourceInitialized"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <!--
        余白は完全な透過にし、カードだけを不透明にする。
        alpha が 0 の余白は、OS のヒットテストでクリックが下へ抜ける。

        ルートの背景を Transparent（alpha 0）にすると、
        ウィンドウ自身がマウスを受け取れなくなる。
        #01000000 はほぼ透明だが、入力は受け取れる。
    -->
    <Grid Background="#01000000" Margin="8">

        <!--
            トレイのアイコン。
            クリックスルーを有効にした窓はマウス入力を受け付けないため、
            ここが常に手の届く解除の経路になる。
            小窓はタスクバーにもAlt+Tabにも出ないので、これが無いと詰む。
        -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Resources/tray.ico"
                        ToolTipText="FursuitWeather"
                        NoLeftClickDelay="True"
                        LeftClickCommand="{x:Null}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="小窓の表示を切り替える" Click="OnToggleVisibility" />
                    <MenuItem Header="いま取り直す" Click="OnRefreshNow" />
                    <MenuItem Header="小窓の位置を戻す" Click="OnResetPosition" />
                    <Separator />
                    <MenuItem x:Name="ClickThroughItem"
                              Header="クリックスルー（Ctrl+Alt+F）"
                              IsCheckable="True"
                              Click="OnToggleClickThrough" />
                    <MenuItem x:Name="PinItem"
                              Header="自動で戻さず保つ"
                              IsCheckable="True"
                              Click="OnPinClickThrough" />
                    <Separator />
                    <MenuItem Header="設定" Click="OnOpenSettings" />
                    <MenuItem Header="更新を確認" Click="OnCheckUpdate" />
                    <MenuItem x:Name="InstallUpdateItem"
                              Header="更新をインストール"
                              IsEnabled="False"
                              Click="OnInstallUpdate" />
                    <MenuItem Header="通知を試す" Click="OnTestNotification" />
                    <MenuItem Header="いまの予報で通知を組み立てる" Click="OnPreviewNotification" />
                    <MenuItem Header="検証に使う情報を見る" Click="OnShowDiagnostics" />
                    <MenuItem Header="終了" Click="OnExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border Background="{StaticResource CardSurface}"
                BorderBrush="{Binding AccentBrush}"
                BorderThickness="2"
                CornerRadius="10"
                Padding="14,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 地点と時刻 -->
                <TextBlock Grid.Row="0"
                           Text="{Binding HeaderText}"
                           FontSize="12"
                           Foreground="{StaticResource CardMutedText}" />

                <!-- 判定。色だけでなく記号と文字でも伝える -->
                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        Padding="8,4"
                        CornerRadius="6"
                        HorizontalAlignment="Left"
                        Background="{Binding SurfaceBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Symbol}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{Binding TextBrush}" />
                        <TextBlock Text="{Binding LevelLabel}"
                                   Margin="8,0,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding TextBrush}" />
                    </StackPanel>
                </Border>

                <!-- 連続活動時間。行動に直結する値なので大きく出す -->
                <TextBlock Grid.Row="2"
                           Margin="0,10,0,0"
                           FontSize="15"
                           Foreground="{StaticResource CardText}"
                           Text="{Binding ActivityText}" />

                <TextBlock Grid.Row="3"
                           Margin="0,6,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource CardMutedText}"
                           Text="{Binding DetailText}" />

                <!--
                    状態の一言。古いデータであることと、公式の発表が出ていることを必ず見せる。
                    静かに古い値を出し続けるのがいちばん危ない
                -->
                <TextBlock Grid.Row="4"
                           Margin="0,0,0,2"
                           FontSize="11"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{Binding AccentBrush}"
                           Text="{Binding StatusText}" />

                <!-- 出典の表記。常に見える位置へ描く義務がある -->
                <TextBlock Grid.Row="5"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource CardMutedText}"
                           Text="{Binding AttributionText}" />
            </Grid>
        </Border>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="クリックスルー（Ctrl+Alt+F）" Click="OnToggleClickThrough" />
                <MenuItem Header="設定" Click="OnOpenSettings" />
                <MenuItem Header="検証に使う情報を見る" Click="OnShowDiagnostics" />
                <Separator />
                <MenuItem Header="終了" Click="OnExit" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
