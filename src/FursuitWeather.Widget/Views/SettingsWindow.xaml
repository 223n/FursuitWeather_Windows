<Window x:Class="FursuitWeather.Widget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FursuitWeather の設定"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <!--
        いま実際に効く項目だけを置く。
        動かない飾りのコントロールを置かない。

        項目が縦に長いため、中身をスクロールできるようにし、ボタンは下に固定する。
        高さの上限は作業領域に合わせてコードで決める。768pxの画面でも保存を押せるようにする
    -->
    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="やめる" Width="90" Height="30" Click="OnCancel" />
            <Button x:Name="SaveButton" Content="保存する" Width="90" Height="30" Margin="10,0,0,0"
                    IsDefault="True" Click="OnSave" />
        </StackPanel>

        <!--
            保存の失敗はボタンのすぐ上に出す。
            スクロールの内側に置くと、下の項目を触っている位置からは見えず、何も起きないように見える
        -->
        <TextBlock x:Name="ErrorText"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="#99260C"
                   Visibility="Collapsed" />

        <!--
            更新の状態はスクロールの外に置き、常に見せる。
            最後に確認した日時は、静かに失敗する設計では「壊れていない」ことの唯一の証拠になる。
            スクロールの下に隠すと、その役を果たさない
        -->
        <StackPanel x:Name="UpdateStatusPanel" DockPanel.Dock="Bottom">
            <Separator Margin="0,12,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="RunningVersionText" FontSize="11" Foreground="#4A4A4A" />
                    <TextBlock x:Name="LastCheckedText" FontSize="11" Foreground="#4A4A4A" Margin="0,2,0,0" />
                    <TextBlock x:Name="UpdateStatusText" FontSize="11" Foreground="#4A4A4A" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CheckUpdateButton"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Width="90"
                        Height="28"
                        VerticalAlignment="Top"
                        Content="今すぐ確認"
                        Click="OnCheckUpdate" />
            </Grid>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">

                <TextBlock Text="地点" FontWeight="Bold" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="#4A4A4A"
                           Text="座標は小数2桁（およそ1km四方）へ丸めてから送ります。本体の公開している約束に合わせるためです。" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="緯度" VerticalAlignment="Center" />
                    <TextBox x:Name="LatitudeBox" Grid.Column="1" Margin="8,0,16,0" />
                    <TextBlock Text="経度" Grid.Column="2" VerticalAlignment="Center" />
                    <TextBox x:Name="LongitudeBox" Grid.Column="3" Margin="8,0,0,0" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="表示名" VerticalAlignment="Center" />
                    <TextBox x:Name="PlaceBox" Grid.Column="1" Margin="8,0,0,0" />
                </Grid>

                <Separator Margin="0,16,0,12" />

                <TextBlock Text="小窓の高さ" FontWeight="Bold" />
                <RadioButton x:Name="LayerTopRadio" Margin="0,8,0,0" GroupName="Layer">
                    <StackPanel>
                        <TextBlock Text="常に手前" />
                        <TextBlock FontSize="11" Foreground="#4A4A4A" TextWrapping="Wrap"
                                   Text="いつでも見えます。配信や画面の共有には映り込みます。" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayerNormalRadio" Margin="0,8,0,0" GroupName="Layer">
                    <StackPanel>
                        <TextBlock Text="ほかの窓に隠れてよい" />
                        <TextBlock FontSize="11" Foreground="#4A4A4A" TextWrapping="Wrap"
                                   Text="作業の邪魔になりません。隠れているあいだは判定が目に入りません。" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayerTrayRadio" Margin="0,8,0,0" GroupName="Layer">
                    <StackPanel>
                        <TextBlock Text="トレイだけ" />
                        <TextBlock FontSize="11" Foreground="#4A4A4A" TextWrapping="Wrap"
                                   Text="小窓を出しません。通知と、トレイのアイコンの上に出る文字だけで伝えます。" />
                    </StackPanel>
                </RadioButton>

                <Separator Margin="0,16,0,12" />

                <TextBlock Text="通知と起動" FontWeight="Bold" />
                <CheckBox x:Name="NotificationsCheck" Margin="0,8,0,0" Content="トースト通知を使う" />
                <TextBlock x:Name="NotificationStateText"
                           Margin="24,2,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="#4A4A4A" />
                <CheckBox x:Name="StartupCheck" Margin="0,10,0,0" Content="Windowsへサインインしたときに起動する" />
                <TextBlock x:Name="StartupStateText"
                           Margin="24,2,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="#7A3100"
                           Visibility="Collapsed" />
                <TextBlock Margin="24,2,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="#4A4A4A"
                           Text="「設定」の「アプリ」の「スタートアップ」やタスクマネージャーからも切り替えられます。" />

                <CheckBox x:Name="StartInDisplayCheck" Margin="0,10,0,0" Content="起動したら掲示で始める" />
                <TextBlock Margin="24,2,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="#4A4A4A"
                           Text="会場の専用端末向けです。停電や再起動のあとも、人の手を借りずに掲示へ戻ります。掲示はEscキーか Ctrl+Alt+D、トレイのメニューで終えられます。" />

                <!--
                    更新の扱い。文言は docs/update.md の「設定画面の文言」に合わせる。
                    モードA、B、Cという記号は見せず、何が起きるかで書く
                -->
                <StackPanel x:Name="UpdateSection">
                    <Separator Margin="0,16,0,12" />

                    <TextBlock Text="更新の扱い" FontWeight="Bold" />
                    <RadioButton x:Name="UpdateAutomaticRadio" Margin="0,8,0,0" GroupName="UpdateMode">
                        <StackPanel>
                            <TextBlock Text="自動で更新する" />
                            <TextBlock FontSize="11" Foreground="#4A4A4A" TextWrapping="Wrap"
                                       Text="確認・取得・インストールまで自動で行います。インストールのあいだ20秒ほどアプリが止まり、自動で起動し直します。" />
                            <TextBlock FontSize="11" Foreground="#4A4A4A" TextWrapping="Wrap"
                                       Text="全画面の表示中や応答不可の時間帯、起動してから10分のあいだは先送りし、そのときだけ押されるのを待ちます。" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="UpdateDownloadOnlyRadio" Margin="0,8,0,0" GroupName="UpdateMode">
                        <StackPanel>
                            <TextBlock Text="取得だけ自動で行う（推奨）" />
                            <TextBlock FontSize="11" Foreground="#4A4A4A" TextWrapping="Wrap"
                                       Text="新しい版を裏で受け取っておき、インストールする時期はあなたが決めます。" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="UpdateNotifyOnlyRadio" Margin="0,8,0,0" GroupName="UpdateMode">
                        <StackPanel>
                            <TextBlock Text="何もしない（お知らせのみ）" />
                            <TextBlock FontSize="11" Foreground="#4A4A4A" TextWrapping="Wrap"
                                       Text="新しい版が出たことだけをお知らせします。取得もインストールも、それぞれボタンを押したときだけ行います。" />
                        </StackPanel>
                    </RadioButton>

                    <CheckBox x:Name="PauseOnMeteredCheck" Margin="0,12,0,0" Content="従量制課金の接続では自動で取得しない" />
                    <CheckBox x:Name="PauseOnBatteryCheck" Margin="0,6,0,0" Content="バッテリー動作中は自動で取得しない" />

                    <TextBlock x:Name="AutoDisabledText"
                               Margin="0,10,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="#7A3100"
                               Visibility="Collapsed"
                               Text="続けて失敗したため、自動での更新を止めています。下の「今すぐ確認」から入れ直すと再開します。" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
