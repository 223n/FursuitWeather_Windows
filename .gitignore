# 依存
node_modules/

# 検査やビルドの出力
*.log

# エディタと OS
.DS_Store
.vscode/settings.json
.idea/

# 環境変数と認証情報。
# npm login が作る .npmrc にはトークンが入るため、リポジトリには入れない
.env
.env.*
!.env.example
.npmrc

# .NET のビルド出力
bin/
obj/
TestResults/

# Visual Studio
.vs/
*.user

# インストーラーの成果物
AppPackages/
dist/

# インストーラーの組み立てで作る中間物（発行結果とランタイム）
artifacts/
*.msix
*.msixbundle

# 署名の証明書。誤ってコミットすると履歴の書き換えが要る
*.pfx
*.snk
*.p12
*.cer
