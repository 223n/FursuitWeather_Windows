<Project>

  <!--
    依存パッケージの版をここへ集約する（Central Package Management）。
    .csproj 側の PackageReference には Version を書かない。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- 画面 -->
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!--
      通知に使う。2.x系の保守期限は2027年4月29日で、2.4へ上げても延びない。
      3.0への移行を年次の作業として計画に入れること
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="1.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
